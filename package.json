{
  "name": "organizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787 --var ENVIRONMENT:development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts *.ts *.json *.jsonc index.html",
    "test": "vitest run",
    "types": "wrangler types",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "deploy:verify": "node scripts/verify-deployment.mjs https://organizer.property-scraper.workers.dev"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "agents": "^0.28.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
